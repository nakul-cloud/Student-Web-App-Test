# ==============================================================================
# ComplyADI - GIFT City IFSC Compliance & Regulatory Assistant
# Environment Configuration Template
# Copy this file to `.env` and fill in your keys before starting the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core Settings
# ------------------------------------------------------------------------------
APP_NAME="ComplyADI - GIFT City Compliance Assistant"
ENV="development"                     # development | staging | production
HOST="0.0.0.0"                        # Bind host (0.0.0.0 allows Docker / network access)
PORT=8000                             # FastAPI backend port

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# In development, all origins are accepted. In production, requests are locked to these domains.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32-character key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY="change_this_to_a_strong_random_secret_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440               # 24 hours (in minutes)

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database (Neon Lakebase Postgres or Local Docker)
# ------------------------------------------------------------------------------
# Local Docker: postgresql+asyncpg://postgres:password123@localhost:5432/compliance_db
# Cloud (Neon): postgresql+asyncpg://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres:password123@localhost:5432/compliance_db"
DATABASE_URL_POOLED="postgresql+asyncpg://postgres:password123@localhost:5432/compliance_db"

# ------------------------------------------------------------------------------
# 5. Redis Cache (Hot Active Session Memory & 2-Hour TTL Buffer)
# ------------------------------------------------------------------------------
# Local Docker: redis://localhost:6379/0
# Cloud (Upstash): rediss://default:pass@us1-xyz.upstash.io:6379
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 6. Qdrant Vectorless RAG Store (BM25 / Payload Full-Text Search)
# ------------------------------------------------------------------------------
# Local Docker: http://localhost:6333
# Cloud Cluster: https://xyz.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="gift_city_compliance"
QDRANT_API_KEY=""                     # Leave blank for local Docker; required for Qdrant Cloud

# ------------------------------------------------------------------------------
# 7. Primary & Fallback LLM Provider (Groq Cloud)
# ------------------------------------------------------------------------------
# Free API key from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
GROQ_PRIMARY_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="qwen/qwen-2.5-32b"

# ------------------------------------------------------------------------------
# 8. Emergency Backup LLM Provider (OpenAI)
# ------------------------------------------------------------------------------
# Used automatically only if both Groq primary and fallback fail
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 9. Safety Guardrails & Gibberish Detection (0 LLM Tokens)
# ------------------------------------------------------------------------------
ENABLE_GUARDRAILS=true
ENABLE_GIBBERISH_DETECTOR=true
GIBBERISH_MIN_VOWEL_RATIO=0.15
GIBBERISH_MAX_REPEAT_CHARS=4
COMPLIANCE_COMPANY_NAME="ADI International"
COMPLIANCE_JURISDICTION="GIFT City IFSC, Gujarat, India"

# ------------------------------------------------------------------------------
# 10. Vectorless RAG & Graph Tuning Parameters
# ------------------------------------------------------------------------------
RETRIEVAL_SCAN_LIMIT=8                # Max candidates scrolled from Qdrant
RETRIEVAL_TOP_K=3                     # Top passages passed to synthesizer
DIRECT_HIT_THRESHOLD=0.75             # Score threshold for 0-token direct return
LLM_HISTORY_WINDOW=4                  # Conversational turns included in LLM context
