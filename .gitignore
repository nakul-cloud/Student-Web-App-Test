# ==============================================================================
# ComplyADI - Git Ignore Configuration
# Prevents accidental commits of secrets, virtual environments, logs, and caches
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
.env/

# --- Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Code Quality Caches ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Application Logs & Runtime Files ---
logs/
*.log
*.sqlite3
*.db

# --- Temporary Files & Uploads ---
tmp/
temp/
.user_uploaded/
scratch/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDEs & Code Editors ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Node / Frontend Caches (if any) ---
node_modules/
.npm/
.yarn/
